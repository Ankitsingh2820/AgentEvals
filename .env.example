# Copy to .env (never commit .env).

# LLM provider keys. Each is needed only for agents (or judges) using that provider;
# provider "mock" runs offline and needs none. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# API key for the dashboard/API, registered (as a hash) on first start if no key exists.
# Generate one:  python -c "import secrets; print('ae_' + secrets.token_urlsafe(32))"
# Or leave empty and create keys later:  docker compose exec api python -m app.auth create dashboard
AGENTEVAL_BOOTSTRAP_API_KEY=

# Send OpenTelemetry traces somewhere (e.g. the bundled Jaeger: http://jaeger:4318).
# Empty = tracing off.
AGENTEVAL_OTEL_EXPORTER_ENDPOINT=

# Host ports. Change any that are already in use on your machine.
AGENTEVAL_WEB_PORT=3000
AGENTEVAL_API_PORT=8000
AGENTEVAL_DB_PORT=5433

# --- Only when running the backend outside Docker ---------------------------------------
AGENTEVAL_DATABASE_URL=postgresql+psycopg://agenteval:agenteval@localhost:5433/agenteval
AGENTEVAL_LOG_LEVEL=INFO
AGENTEVAL_MAX_AGENT_ITERATIONS=10
# inline = run evaluations inside the API process; celery = queue on Redis (needs a worker)
AGENTEVAL_TASK_BACKEND=inline
AGENTEVAL_REDIS_URL=
# Leave auth on. Turning it off is only for isolated local experiments.
AGENTEVAL_AUTH_ENABLED=true
AGENTEVAL_RATE_LIMIT_PER_MINUTE=120
AGENTEVAL_EXECUTE_RATE_LIMIT_PER_MINUTE=20
